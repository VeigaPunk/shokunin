# hyaku tunables — sourced by every slot at the start of each round (edit live; no restart).
# In-session campaign (phase 2, 2026-10-20): L1 lane subagents and closure judges run as generic
# `task` agents; the global `task.agentModelOverrides` routes generic task -> @m_swe after the
# operator's Kimi 429/routing instruction on 2026-10-24. Closures are fresh sessions dispatched
# by the orchestrator — non-author by session. These values are labels for prompts/events;
# the global role map remains the routing authority.
L1_MODEL=@m_swe
JUDGE_MODEL=@m_swe
# Lane VCS: jj = lanes are jj-colocated at dispatch/closure time and commit through
# scripts/hyaku/jj-lane.sh (operator 2026-10-20: "jj as git manager from now on on shokunin runs").
HYAKU_VCS=jj
TARGET=100
MAX_ATTEMPTS=3
ROUND_MAXTIME=170m
ROUND_TIMEOUT=180m
CLOSURE_MAXTIME=60m
CLOSURE_TIMEOUT=70m
