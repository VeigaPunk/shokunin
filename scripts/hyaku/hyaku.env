# hyaku tunables — sourced by every slot at the start of each round (edit live; no restart).
# In-session campaign (phase 2, 2026-10-20): L1 lane subagents and closure judges run as generic
# `task` agents; the session's task.agentModelOverrides binds task -> @m_kfc (operator directive,
# 2026-10-23, run 5: "swap m_opus for m_kfc; across all roles on the run"). Closures are fresh
# sessions dispatched by the orchestrator — non-author by session. These two values are labels
# for prompts and events; routing is the role map.
L1_MODEL=@m_kfc
JUDGE_MODEL=@m_kfc
# Lane VCS: jj = lanes are jj-colocated at dispatch/closure time and commit through
# scripts/hyaku/jj-lane.sh (operator 2026-10-20: "jj as git manager from now on on shokunin runs").
HYAKU_VCS=jj
TARGET=100
MAX_ATTEMPTS=3
ROUND_MAXTIME=170m
ROUND_TIMEOUT=180m
CLOSURE_MAXTIME=60m
CLOSURE_TIMEOUT=70m
