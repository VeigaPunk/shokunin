# hyaku tunables — sourced by every slot at the start of each round (edit live; no restart).
# In-session campaign: L1 lane subagents run as generic `task` agents (session cfg binds task -> @m_strong,
# the UFO missionFormat.l1Alias); closure judges are fresh generic `task` agents dispatched by the
# orchestrator (task -> @m_strong; per-task model pins are seance-only) — non-author by session.
L1_MODEL=@m_strong
JUDGE_MODEL=@m_strong
TARGET=100
MAX_ATTEMPTS=3
ROUND_MAXTIME=170m
ROUND_TIMEOUT=180m
CLOSURE_MAXTIME=60m
CLOSURE_TIMEOUT=70m
